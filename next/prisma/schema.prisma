// Kizunia Web — Prisma Schema
//
// Architecture: PostgreSQL + Prisma ORM
// Auth: Better Auth (User, Session, Account, Verification)
//
// Conventions:
// - Better Auth tables must remain compatible — do not rename their fields.
// - Badge is generic — not limited to verification.
// - CompetitionStatus contains lifecycle values only. Moderation belongs to a future Proposal model.
// - Major entities support soft delete via deletedAt.
// - Audit fields (createdById, updatedById) use SetNull so history survives user deletion.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums — User
// =============================================================================

enum UserVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// =============================================================================
// Enums — Competition
// =============================================================================
enum SuggestionStatus {
  DRAFT
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CompetitionMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum CompetitionVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
  ARCHIVED
}

// Lifecycle-only status. Moderation workflow (draft, submitted, pending review,
// approved) belongs to a future Proposal model — not the Competition itself.
enum CompetitionStatus {
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

// Competitions support multiple member roles beyond simple maintainers.
enum CompetitionMemberRole {
  OWNER
  ORGANIZER
  MAINTAINER
}

enum RegistrationPlatform {
  KIZUNIA

  UNSTOP
  DEVPOST
  DEVFOLIO
  DORAHACKS
  HACK2SKILL
  HACKEREARTH
  TAIKAI
  LUMA

  GOOGLE_FORM
  TYPEFORM

  CUSTOM
  OFFLINE
  OTHER
}

enum RegistrationType {
  INDIVIDUAL
  TEAM
  BOTH
}

enum RegistrationFeeType {
  FREE
  PAID
  CONDITIONAL
}

enum OrganizerType {
  COLLEGE
  COMPANY
  COMMUNITY
  GOVERNMENT
  NON_PROFIT
  STARTUP
  INDIVIDUAL
  OPEN_SOURCE
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  OPEN
}

enum CertificateType {
  NONE
  PARTICIPATION
  WINNER
}

enum EligibilityType {
  // Education
  SCHOOL
  UNDERGRADUATE
  POSTGRADUATE
  PHD

  // Experience
  FRESHER
  PROFESSIONAL

  // Academic Stream
  ENGINEERING
  MANAGEMENT
  DESIGN
  SCIENCE
  COMMERCE
  ARTS
  MEDICAL
  LAW

  // General
  OPEN
  OTHER
}

// =============================================================================
// Enums — Project
// =============================================================================

enum ProjectVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum ProjectRole {
  OWNER
  MAINTAINER
  CONTRIBUTOR
}

enum AssetProvider {
  CLOUDINARY
}

enum LinkType {
  WEBSITE
  REGISTRATION
  GITHUB
  GITLAB
  DEMO
  DOCUMENTATION
  FIGMA
  DEVPOST
  DEVFOLIO
  UNSTOP
  LINKEDIN
  TWITTER
  INSTAGRAM
  DISCORD
  YOUTUBE
  PORTFOLIO
  OTHER
}

// =============================================================================
// Better Auth Models — DO NOT MODIFY unless absolutely necessary
// =============================================================================

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  username        String?
  displayUsername String?

  // --- Kizunia Custom Fields ---

  // Profile
  headline       String?
  bio            String?
  college        String?
  degree         String?
  graduationYear Int?
  location       String?
  avatarAssetId  String?
  avatarAsset    Asset?  @relation("userAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)

  coverAssetId String?
  coverAsset   Asset?  @relation("userCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  // System
  visibility UserVisibility @default(PUBLIC)
  status     UserStatus     @default(ACTIVE)

  // Relationships
  links                         Link[]
  technologies                  UserTechnology[]
  interests                     UserCategory[]
  notificationPref              NotificationPreference?
  badges                        UserBadge[]
  competitionMembers              CompetitionMember[]
  competitionBookmarks            CompetitionBookmark[]
  // ---------------------------------------------------------------------------
  // Competition Suggestions
  // ---------------------------------------------------------------------------
  competitionSuggestionsSubmitted CompetitionSuggestion[]   @relation("competitionSuggestionSubmittedBy")
  competitionSuggestionsReviewed  CompetitionSuggestion[]   @relation("competitionSuggestionReviewedBy")
  projectMembers                ProjectMember[]

  // Audit — entities created or last updated by this user
  competitionsCreated Competition[] @relation("competitionCreatedBy")
  competitionsUpdated Competition[] @relation("competitionUpdatedBy")

  projectsCreated Project[] @relation("projectCreatedBy")
  projectsUpdated Project[] @relation("projectUpdatedBy")

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// =============================================================================
// Shared Models — Link, Asset, Technology, Category, Badge
// =============================================================================

// External links (GitHub, LinkedIn, Portfolio, etc.)
// Uses optional foreign keys instead of polymorphic relations for Prisma compatibility.
model Link {
  id    String   @id @default(cuid())
  url   String
  title String
  type  LinkType
  order Int      @default(0)

  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  competitionSuggestion   CompetitionSuggestion? @relation(fields: [competitionSuggestionId], references: [id])
  competitionSuggestionId String?

  @@index([userId])
  @@index([competitionId])
  @@index([projectId])
  @@index([competitionSuggestionId])
  @@map("link")
}

// Identity Asset (avatars, banners, logos). Stored via Cloudinary.
// Content Asset (screenshots, diagrams) lives in documentation or external links.
model Asset {
  id String @id @default(cuid())

  provider AssetProvider

  publicId String @unique

  secureUrl String

  format String?

  mimeType String?

  width Int?

  height Int?

  bytes            Int?
  checksum         String?
  originalFilename String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // User
  userAvatar User[] @relation("userAvatar")
  userCover  User[] @relation("userCover")

  // Competition
  competitionLogo   Competition[] @relation("competitionLogo")
  competitionBanner Competition[] @relation("competitionBanner")
  competitionCover  Competition[] @relation("competitionCover")

  // Suggestion
  suggestionLogo   CompetitionSuggestion[] @relation("suggestionLogo")
  suggestionBanner CompetitionSuggestion[] @relation("suggestionBanner")
  suggestionCover  CompetitionSuggestion[] @relation("suggestionCover")

  // Project
  projectLogo  Project[] @relation("projectLogo")
  projectCover Project[] @relation("projectCover")

  @@map("asset")
}

// Global pool of technologies/skills. Shared across Users, Projects, Competitions.
model Technology {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  iconUrl     String?
  description String?

  users                           UserTechnology[]
  competitions                      CompetitionTechnology[]
  projects                        ProjectTechnology[]
  competitionSuggestionTechnologies CompetitionSuggestionTechnology[]

  @@map("technology")
}

// Global pool of categories/interests. Shared across Users, Competitions, Projects.
model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  users                         UserCategory[]
  competitions                    CompetitionCategory[]
  projects                      ProjectCategory[]
  competitionSuggestionCategories CompetitionSuggestionCategory[]

  @@map("category")
}

// Generic badge system. Not limited to verification — supports user badges,
// project badges, and future entity badges (teams, competitions).
model Badge {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  iconUrl     String?

  users    UserBadge[]
  projects ProjectBadge[]

  @@map("badge")
}

// =============================================================================
// User Domain — Join Tables
// =============================================================================

model UserTechnology {
  userId       String
  technologyId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([userId, technologyId])
  @@map("user_technology")
}

model UserCategory {
  userId     String
  categoryId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("user_category")
}

model UserBadge {
  userId   String
  badgeId  String
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badge")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(false)
  preferences        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("notification_preference")
}

// =============================================================================
// Competition Domain (HD/CD)
// =============================================================================

model Competition {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  shortDescription String?

  organizer            String?
  mode                 CompetitionMode?
  location             String?
  minTeamSize          Int?
  maxTeamSize          Int?
  registrationLink     String?
  website              String?
  startDate            DateTime?
  endDate              DateTime?
  registrationDeadline DateTime?
  prizePool            String?
  logoAssetId          String?
  logoAsset            Asset?         @relation("competitionLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)

  bannerAssetId String?
  bannerAsset   Asset?  @relation("competitionBanner", fields: [bannerAssetId], references: [id], onDelete: SetNull)

  coverAssetId String?
  coverAsset   Asset?  @relation("competitionCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  // documentation String? @db.Text
  contentId String?  @unique
  content   Content? @relation("CompetitionContent", fields: [contentId], references: [id], onDelete: SetNull)

  visibility CompetitionVisibility @default(PRIVATE)
  // Lifecycle-only. Moderation status belongs to a future Proposal model.
  status     CompetitionStatus?

  // Audit — tracks who created and last updated this competition.
  // Uses SetNull so audit history survives user deletion.
  createdById String?
  createdBy   User?   @relation("competitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("competitionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete — rows are never permanently removed from major entities.
  deletedAt DateTime?

  categories   CompetitionCategory[]
  technologies CompetitionTechnology[]
  members      CompetitionMember[]
  bookmarks    CompetitionBookmark[]
  projects     CompetitionProject[]

  links Link[]
  // ---------------------------------------------------------------------------
  // Suggestions
  // ---------------------------------------------------------------------------

  suggestions   CompetitionSuggestion[]  @relation("competitionSuggestionTarget")
  // competitionEligibilities CompetitionEligibility[]
  eligibilities CompetitionEligibility[]

  registrationPlatform RegistrationPlatform?

  registrationType RegistrationType?

  registrationFeeType RegistrationFeeType?

  registrationFee String?

  organizerType OrganizerType?

  difficulty DifficultyLevel?

  certificateType CertificateType?

  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@index([startDate])
  @@index([registrationDeadline])
  @@index([createdById])
  @@index([updatedById])
  @@map("competition")
}

model CompetitionSuggestion {
  id String @id @default(cuid())

  // ===========================================================================
  // Workflow
  // ===========================================================================

  status SuggestionStatus @default(DRAFT)

  submittedAt DateTime?
  reviewedAt  DateTime?

  reviewNotes     String? @db.Text
  rejectionReason String? @db.Text

  // ===========================================================================
  // Relationships
  // ===========================================================================

  // NULL => New Competition
  // NOT NULL => Edit Existing Competition
  competitionId String?
  competition   Competition? @relation("competitionSuggestionTarget", fields: [competitionId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("competitionSuggestionSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("competitionSuggestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  // ===========================================================================
  // Contributor Editable Fields
  // ===========================================================================

  title String?

  shortDescription String?

  organizer String?

  mode CompetitionMode?

  location String?

  registrationLink String?

  website String?

  startDate DateTime?

  endDate DateTime?

  registrationDeadline DateTime?

  minTeamSize Int?

  maxTeamSize Int?

  prizePool String?

  documentation String? @db.Text

  // ===========================================================================
  // Audit
  // ===========================================================================

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ===========================================================================
  // Relations
  // ===========================================================================

  categories   CompetitionSuggestionCategory[]
  technologies CompetitionSuggestionTechnology[]

  links       Link[]
  logoAssetId String?
  logoAsset   Asset?  @relation("suggestionLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)

  bannerAssetId String?
  bannerAsset   Asset?  @relation("suggestionBanner", fields: [bannerAssetId], references: [id], onDelete: SetNull)

  coverAssetId String?
  coverAsset   Asset?  @relation("suggestionCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([competitionId])
  @@index([createdAt])
  @@map("competition_suggestion")
}

// Competition members with role-based access. Replaces the old CompetitionMaintainer
// model to support multiple roles (owner, organizer, maintainer).
model CompetitionMember {
  competitionId String
  userId      String
  role        CompetitionMemberRole @default(MAINTAINER)
  assignedAt  DateTime            @default(now())
  competition   Competition           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([competitionId, userId])
  @@map("competition_member")
}

model CompetitionCategory {
  competitionId String
  categoryId  String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([competitionId, categoryId])
  @@map("competition_category")
}

model CompetitionTechnology {
  competitionId  String
  technologyId String
  competition    Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([competitionId, technologyId])
  @@map("competition_technology")
}

model CompetitionEligibility {
  competitionId String
  type        EligibilityType

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, type])
  @@index([type])
  @@map("competition_eligibility")
}

model CompetitionBookmark {
  competitionId String
  userId      String
  createdAt   DateTime  @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([competitionId, userId])
  @@map("competition_bookmark")
}

model CompetitionSuggestionCategory {
  suggestionId String
  categoryId   String

  suggestion CompetitionSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  category   Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([suggestionId, categoryId])
  @@map("competition_suggestion_category")
}

model CompetitionSuggestionTechnology {
  suggestionId String
  technologyId String

  suggestion CompetitionSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  technology Technology          @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([suggestionId, technologyId])
  @@map("competition_suggestion_technology")
}

// =============================================================================
// Project Domain
// =============================================================================

model Project {
  id               String @id @default(cuid())
  title            String
  slug             String @unique
  shortDescription String

  // documentation String? @db.Text
  contentId String?  @unique
  content   Content? @relation("ProjectContent", fields: [contentId], references: [id], onDelete: SetNull)

  visibility ProjectVisibility @default(PUBLIC)
  status     ProjectStatus     @default(DRAFT)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  members      ProjectMember[]
  categories   ProjectCategory[]
  technologies ProjectTechnology[]
  badges       ProjectBadge[]
  competitions   CompetitionProject[]

  links       Link[]
  logoAssetId String?
  logoAsset   Asset?  @relation("projectLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)

  coverAssetId String?
  coverAsset   Asset?  @relation("projectCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("projectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("projectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@map("project")
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(CONTRIBUTOR)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_member")
}

model ProjectCategory {
  projectId  String
  categoryId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@map("project_category")
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@map("project_technology")
}

model ProjectBadge {
  projectId String
  badgeId   String
  issuedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([projectId, badgeId])
  @@map("project_badge")
}

// Many-to-many: a project can be submitted to multiple competitions.
model CompetitionProject {
  competitionId String
  projectId   String
  submittedAt DateTime  @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([competitionId, projectId])
  @@map("competition_project")
}

model Content {
  id String @id @default(cuid())

  content String @db.Text

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competition Competition? @relation("CompetitionContent")
  project   Project?   @relation("ProjectContent")
  // team      Team?      @relation("TeamContent")
  // blog      Blog?      @relation("BlogContent")
}
