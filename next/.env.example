DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kizunia"
BETTER_AUTH_SECRET=yourSecreatKeyHereAnyRandomStringg
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL = http://localhost:3000

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME =
CLOUDINARY_API_KEY =
CLOUDINARY_API_SECRET =

# Location search (optional).
# Leaving these unset is a supported production configuration: location search
# falls back to places already stored on Kizunia plus manual entry, and
# competition editing keeps working either way.
# Set LOCATION_PROVIDER=nominatim to enable external geocoding. Nominatim's
# usage policy requires an identifying contact string and rate-limits to roughly
# one request per second — point NOMINATIM_BASE_URL at a self-hosted instance
# for anything heavier.
LOCATION_PROVIDER =
LOCATION_PROVIDER_USER_AGENT =
NOMINATIM_BASE_URL =